+ 		kfpu_do_xrstor("xrstor", state, ~XFEATURE_MASK_XTILE);
+ 		goto out;
+ 	}
+ #endif
+-	if (static_cpu_has(X86_FEATURE_FXSR)) {
++	if (cpu_feature_enabled(X86_FEATURE_FXSR)) {
+ 		kfpu_restore_fxsr(state);
+ 	} else {
+ 		kfpu_restore_fsave(state);
+Index: zfs-linux-2.4.4/module/zcommon/simd_stat.c
+===================================================================
+--- zfs-linux-2.4.4.orig/module/zcommon/simd_stat.c
++++ zfs-linux-2.4.4/module/zcommon/simd_stat.c
+@@ -126,13 +126,13 @@ simd_stat_kstat_data(char *buf, size_t s
+ 		off += SIMD_STAT_PRINT(simd_stat_kstat_payload,
+ 		    "osxsave", boot_cpu_has(X86_FEATURE_OSXSAVE));
