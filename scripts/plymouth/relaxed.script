num_frames = 72;
ticks_per_frame = 3;

screen_width = Window.GetWidth();
screen_height = Window.GetHeight();

frame_native_w = 352;
frame_native_h = 480;

scale = screen_height / frame_native_h;
scaled_w = Math.Int(frame_native_w * scale);
offset_x = Math.Int((screen_width - scaled_w) / 2);

bg = Image("black.png").Scale(screen_width, screen_height);
bg_sprite = Sprite(bg);
bg_sprite.SetPosition(0, 0, 0);

frames = [];
for (i = 0; i < num_frames; i++) {
    frames[i] = Image("frame_" + i + ".png").Scale(scaled_w, screen_height);
}

frame_sprite = Sprite(frames[0]);
frame_sprite.SetPosition(offset_x, 0, 1);

current_frame = 0;
tick = 0;

fun refresh_callback() {
    tick++;
    if (tick >= ticks_per_frame) {
        tick = 0;
        current_frame++;
        if (current_frame >= num_frames) current_frame = 0;
        frame_sprite.SetImage(frames[current_frame]);
    }
}

Plymouth.SetRefreshFunction(refresh_callback);
