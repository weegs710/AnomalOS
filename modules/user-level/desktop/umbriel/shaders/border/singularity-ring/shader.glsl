// A singularity's corona along the window outline: four fitted corona quadrants on a 2 s loop and a 6 s glow breath, hue from the scheme.
// Logical px per ring px; larger reads too thick on the desktop.
const float K_SCALE = 0.42;
// The window is the disc: its edge is the limb, the overlay draws the inside.
const float LIMB_D = 0.0;
// Ring px per theta sample (2 pi * 140.95 / 1024) and samples per 90 degree tile.
const float SAMPLE = 0.86488;
const float TILE_N = 256.0;
const float LOOP = 2.0;
const float BAND_LOOP = 6.0;
// REACH must stay under border width + padding; the tallest plume lands at about 15, and the last FADE px taper it so nothing is cut flat.
const float REACH = 24.0;
const float FADE = 12.0;
// Ring px where the corona's sprites fade out; the corona is gone past about +64.
const float SPR_R0 = 45.0;
const float SPR_R1 = 75.0;
// The glow band against the window is narrowed to this share of its fitted width.
const float BAND_THIN = 0.30;
// The plumes' length as a share of their fitted length, pulled in toward the border; along-edge size unchanged.
const float OUT_THIN = 0.5;
// The share of a colour the client's antialiased corner pixels show (207 of 255 measured with both effects white), and the px round the corner that are dimmed to match.
const float CORNER_DIM = 0.81;
const float CORNER_R0 = 3.0;
const float CORNER_R1 = 8.0;
// How far off the shared 2 s clock each slot may start, as a share of the loop.
const float JITTER = 0.35;
// The calm-to-hot swing along the outline, its length in logical px and how fast it drifts.
const float DRIFT = 0.35;
const float DRIFT_LEN = 260.0;
const float DRIFT_RATE = 0.06;
// Ring px over which the limb ramps from the disc's red rim into the cream plateau, so its inner edge is not a hard line.
const float LIMB_SOFT = 6.0;
// The colour the inner overlay arrives at on the client edge, so the two meet without a seam (value at r = -2, whiteness at r = 0).
const float RIM_V = 0.967;
const float RIM_W = 0.278;
// A feed that is connected but silent counts as no feed, so the effect is its idle look.
const float SILENCE_LOW = 0.02;
const float SILENCE_HIGH = 0.10;
// The same hit the cursor surges on: loudness or the lowest bass, whichever is stronger, from where it starts to where it is full, and how much further the band reaches on a full hit (the cursor's 9 to 15 px swell).
const float HIT0 = 0.05;
const float HIT1 = 0.5;
const float SURGE = 0.67;
// Slows or speeds the whole animation together.
const float SPEED = 1.0;
// Extra radius used to space the corona round a corner, so it fans out instead of bunching.
const float CORNER_REF = 3.0;
const float QUARTER = 1.5708;

float audio_level() {
    float sum = 0.0;
    for (int i = 0; i < 8; i++) {
        sum += umbriel_audio_spectrum((float(i) + 0.5) / 8.0);
    }
    return sum * 0.125;
}

float se_hash(vec2 p) {
    return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453);
}

// Smooth value noise along one axis, 0 to 1.
float se_vn(float x, float seed) {
    float i = floor(x);
    float f = fract(x);
    f = f * f * (3.0 - 2.0 * f);
    return mix(se_hash(vec2(i, seed)), se_hash(vec2(i + 1.0, seed)), f);
}

float se_softplus(float x) {
    return x > 15.0 ? x : log(1.0 + exp(x));
}

float ring_distance(vec2 p) {
    return umbriel_border_distance(umbriel_border_hole.xy + p / umbriel_size);
}

// x: position along the client outline (clockwise from the end of the top-left corner), y: outline length.
vec2 se_outline(vec2 p, vec2 size) {
    vec4 r = umbriel_border_radius;
    vec4 ra = r + vec4(CORNER_REF);
    float o1 = size.x - r.x - r.y;
    float o2 = o1 + QUARTER * ra.y;
    float o3 = o2 + size.y - r.y - r.z;
    float o4 = o3 + QUARTER * ra.z;
    float o5 = o4 + size.x - r.z - r.w;
    float o6 = o5 + QUARTER * ra.w;
    float o7 = o6 + size.y - r.w - r.x;
    float perim = o7 + QUARTER * ra.x;

    float s;
    if (p.x < r.x && p.y < r.x) {
        vec2 v = p - vec2(r.x);
        s = o7 + clamp(atan(-v.y, -v.x), 0.0, QUARTER) * ra.x;
    } else if (p.x > size.x - r.y && p.y < r.y) {
        vec2 v = p - vec2(size.x - r.y, r.y);
        s = o1 + clamp(atan(v.x, -v.y), 0.0, QUARTER) * ra.y;
    } else if (p.x > size.x - r.z && p.y > size.y - r.z) {
        vec2 v = p - vec2(size.x - r.z, size.y - r.z);
        s = o3 + clamp(atan(v.y, v.x), 0.0, QUARTER) * ra.z;
    } else if (p.x < r.w && p.y > size.y - r.w) {
        vec2 v = p - vec2(r.w, size.y - r.w);
        s = o5 + clamp(atan(-v.x, v.y), 0.0, QUARTER) * ra.w;
    } else {
        vec2 inset = vec2(max(-p.x, p.x - size.x), max(-p.y, p.y - size.y));
        if (inset.y > inset.x) {
            s = p.y < 0.0 ? p.x - r.x : o4 + size.x - r.z - p.x;
        } else {
            s = p.x > size.x ? o2 + p.y - r.y : o6 + size.y - r.w - p.y;
        }
    }
    return vec2(s, perim);
}

