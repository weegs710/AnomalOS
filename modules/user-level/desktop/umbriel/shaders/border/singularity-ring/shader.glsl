// One corona quadrant at loop time t; x in theta samples from the quadrant start, r in ring px from the limb.
float se_quadrant(float q, float x, float r, float t, float lift) {
    float p = 6.2831853 * fract(t / LOOP);
    // Harmonics 2-8 by turning the first round itself, one cos and sin instead of sixteen.
    vec2 h1 = vec2(cos(p), sin(p));
    vec2 h2 = se_turn(h1, h1);
    vec2 h3 = se_turn(h2, h1);
    vec2 h4 = se_turn(h3, h1);
    vec2 h5 = se_turn(h4, h1);
    vec2 h6 = se_turn(h5, h1);
    vec2 h7 = se_turn(h6, h1);
    vec2 h8 = se_turn(h7, h1);
    vec4 c1 = vec4(h1.x, h2.x, h3.x, h4.x);
    vec4 c2 = vec4(h5.x, h6.x, h7.x, h8.x);
    vec4 s1 = vec4(h1.y, h2.y, h3.y, h4.y);
    vec4 s2 = vec4(h5.y, h6.y, h7.y, h8.y);
    if (q < 0.5) return se_q0(x, r, c1, c2, s1, s2, lift);
    if (q < 1.5) return se_q1(x, r, c1, c2, s1, s2, lift);
    if (q < 2.5) return se_q2(x, r, c1, c2, s1, s2, lift);
    return se_q3(x, r, c1, c2, s1, s2, lift);
}

// The palette's first colour is accent_primary.
vec3 se_base() {
    return umbriel_palette_count > 0 ? umbriel_palette_at(0.0).rgb : vec3(1.0, 0.165, 0.133);
}

// Value and whiteness on the scheme's hue: whiteness only lifts the min channel, so the fitted orange drift is dropped.
vec3 se_colour(float v, float w, vec3 base) {
    float hi = max(base.r, max(base.g, base.b));
    float lo = min(base.r, min(base.g, base.b));
    vec3 hue = hi - lo > 0.001 ? (base - lo) / (hi - lo) : vec3(1.0);
    float wp = hi > 0.001 ? lo / hi : 1.0;
    float wo = 1.0 - (1.0 - w) * (1.0 - wp);
    return v * mix(hue, vec3(1.0), wo);
}

vec4 border(vec2 uv) {
    vec2 coords = (uv - umbriel_border_hole.xy) * umbriel_size;
    vec2 size = umbriel_border_hole.zw * umbriel_size;
    float d = ring_distance(coords);
    if (d < -1.0 || d > REACH) return vec4(0.0);

    float t = umbriel_time * SPEED;
    vec2 o = se_outline(coords, size);
    float s = o.x;
    float r = (d - LIMB_D) / K_SCALE;
    vec3 base = se_base();

    float lvl0 = audio_level();
    float au = umbriel_audio_available() * smoothstep(SILENCE_LOW, SILENCE_HIGH, lvl0);
    // The spectrum runs from bass along the top to treble along the bottom, the cursor's layout.
    float bl = au * umbriel_audio_spectrum(0.85 * clamp(coords.y / max(size.y, 1.0), 0.0, 1.0));
    float lvl = au * lvl0;
    float bass = au * umbriel_audio_spectrum(0.08);
    float flare = mix(1.0, 0.9 + 0.5 * lvl, au);

    // The outline holds whole rings of the four quadrants, so the loop closes without a seam.
    float ring_len = 4.0 * TILE_N * SAMPLE * K_SCALE;
    float nq = 4.0 * max(floor(o.y / ring_len + 0.5), 1.0);
    float ql = o.y / nq;
    float qi = floor(s / ql);
    float x = (s / ql - qi) * TILE_N;
    // The hole is cut with antialiasing at the rounded corners, so the limb colour carries a pixel inside the edge for the partly cut pixels.
    r = max(r, 0.0);

    // The hit is loudness or the lowest bass, whichever is stronger, the cursor's swell signal.
    float lift = 1.0 + au * (0.3 + 0.9 * bl) + SURGE * smoothstep(HIT0, HIT1, au * max(lvl0, umbriel_audio_spectrum(0.05)));
    float rs = r / (1.0 + au * 0.6 * bass);
    float heat = se_static_heat(rs / BAND_THIN);
    heat += se_band_prof(r / BAND_THIN) * se_band_wave(t);
    // Each slot along the outline plays its own pick of the four quadrants, mirrored or not, a little off the shared clock, so the edge does not read as a repeating tile.
    float spr = 0.0;
    for (int j = -1; j <= 1; j++) {
        float fj = float(j);
        float slot = mod(qi + fj, nq);
        float q = floor(4.0 * se_hash(vec2(slot, 1.3)));
        float xl = x - fj * TILE_N;
        xl = se_hash(vec2(slot, 2.9)) < 0.5 ? xl : TILE_N - xl;
        float toff = JITTER * LOOP * se_hash(vec2(slot, 4.7));
        spr += se_quadrant(q, xl, r / OUT_THIN, t + toff, lift);
    }
    // A slow swell along the outline, so some stretches run calmer and some hotter.
    spr *= mix(1.0 - DRIFT, 1.0 + 0.5 * DRIFT, se_vn(s / DRIFT_LEN + t * DRIFT_RATE, 7.0));
    // A few fitted sprites are soft background haze with no top; they end where the corona ends instead of at REACH.
    spr *= 1.0 - smoothstep(SPR_R0, SPR_R1, r / OUT_THIN / lift);
    heat += spr * mix(1.0, 1.0 + 0.6 * bl, au);
    heat = clamp(heat, 0.0, 215.0);
    vec3 c = se_colour(se_heat_v(heat), se_heat_w(heat), base);
    c = mix(se_colour(RIM_V, RIM_W, base), c, smoothstep(0.0, LIMB_SOFT, r));
    // The client's antialiased corner pixels can only show CORNER_DIM of any colour, so the whole pixels round them come down to match.
    vec2 cv = vec2(coords.x < 0.5 * size.x ? coords.x : size.x - coords.x, coords.y < 0.5 * size.y ? coords.y : size.y - coords.y);
    c *= abs(d) < 0.45 ? 1.0 : mix(CORNER_DIM, 1.0, smoothstep(CORNER_R0, CORNER_R1, length(cv)));
    c = min(c * flare, vec3(1.0)) * (1.0 - smoothstep(REACH - FADE, REACH, d));
    float a = max(c.r, max(c.g, c.b));
    return vec4(c, a);
}
