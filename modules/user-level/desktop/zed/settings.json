// declared baseline for zed; gui edits get pulled back into the repo with `zed-s` (copy-type, see nushell/config.nu)
{
  "cli_default_open_behavior": "existing_window",
  "preferred_line_length": 80,
  "horizontal_scroll_margin": 999.0,
  "vertical_scroll_margin": 999.0,
  "proxy": "",
  "show_whitespaces": "all",
  "disable_ai": true,
  "code_lens": "menu",
  "current_line_highlight": "line",
  "colorize_brackets": true,
  "completions": {
    "lsp_insert_mode": "replace",
  },
  "redact_private_values": true,
  "tab_size": 2,
  "diff_view_style": "unified",
  "image_viewer": {
    "unit": "decimal",
  },
  "diagnostics": {
    "inline": {
      "enabled": true,
      "max_severity": "error",
    },
  },
  "indent_guides": {
    "background_coloring": "disabled",
    "active_line_width": 3,
    "coloring": "fixed",
    "line_width": 1,
  },
  "toolbar": {
    "agent_review": false,
    "breadcrumbs": false,
    "quick_actions": false,
  },
  "minimap": {
    "thumb_border": "none",
    "thumb": "hover",
  },
  "which_key": {
    "delay_ms": 0,
    "enabled": true,
  },
  "icon_theme": "Triglavian Icons",
  "buffer_font_size": 16.0,
  "ui_font_size": 18.0,
  "ui_font_family": "SpaceGrotesk Nerd Font Propo",
  "buffer_line_height": "standard",
  "buffer_font_family": "SpaceMono Nerd Font Mono",
  "telemetry": {
    "diagnostics": false,
    "metrics": false,
    "anthropic_retention": false,
  },
  "terminal": {
    "copy_on_select": false,
    "blinking": "on",
    "cursor_shape": "bar",
    "font_family": "SpaceMono Nerd Font Mono",
    // Space Mono lacks the nom status symbols, so they fell through to the proportional emoji font
    "font_fallbacks": ["Iosevka Nerd Font Mono"],
    "font_size": 14.0,
    // Space Mono's powerline glyphs span 1.5em, taller than the 1.3 default row, so pill caps overshoot the body
    "line_height": { "custom": 1.5 },
  },
  "collaboration_panel": {
    "button": false,
  },
  "outline_panel": {
    "button": false,
  },
  "git_panel": {
    "button": false,
  },
  "tab_bar": {
    "show_nav_history_buttons": false,
    "show_tab_bar_buttons": false,
  },
  "tabs": {
    "activate_on_close": "neighbour",
    "file_icons": true,
    "git_status": false,
    "show_diagnostics": "errors",
  },
  "project_panel": {
    "dock": "left",
    "git_status": false,
    "hide_root": true,
    "scrollbar": {
      "show": "never",
    },
  },
  "theme": "Noctalia Dark",
  "format_on_save": "on",

  // grammar + adapter wasm for non-core languages (html auto-installs by zed default)
  "auto_install_extensions": {
    "nix": true,
    "nu": true,
    "marksman": true,
    "charmed-icons": true,
  },
  "title_bar": {
    "show_branch_status_icon": true,
    "show_onboarding_banner": false,
    "show_sign_in": false,
    "show_user_menu": false,
    "show_user_picture": false,
  },
  "theme_overrides": {
    // noctalia maps strings, numbers and constants to tertiary, which is too dark to read on the editor background
    "Noctalia Dark": {
      "syntax": {
        "keyword": { "color": "#ff1a1a", "font_weight": 700 },
        "function": { "color": "#ff3b30" },
        "type": { "color": "#d6dbe3" },
        "constructor": { "color": "#d6dbe3" },
        "string": { "color": "#a9b4c9" },
        "string.escape": { "color": "#ff1a1a" },
        "string.regex": { "color": "#ff1a1a" },
        "string.special": { "color": "#ff3b30" },
        "string.special.symbol": { "color": "#ff1a1a" },
        "text.literal": { "color": "#a9b4c9" },
        "number": { "color": "#ff1a1a" },
        "constant": { "color": "#ff1a1a" },
        "boolean": { "color": "#ff1a1a" },
        "variable": { "color": "#e8ecf1" },
        "variable.special": { "color": "#ff3b30" },
        "property": { "color": "#c6ccd5" },
        "operator": { "color": "#8e96a6" },
        "punctuation": { "color": "#5f6572" },
        "punctuation.bracket": { "color": "#8e96a6" },
        "punctuation.delimiter": { "color": "#5f6572" },
        "tag": { "color": "#ff1a1a" },
        "comment": { "color": "#7d8290", "font_style": "italic" },
        "comment.doc": { "color": "#7d8290", "font_style": "italic" },
      },
    },
    "Noctalia Dark Transparent": {
      "syntax": {
        "constant.comment.todo": { "color": "#fb923c" },
        "keyword.comment.warn": { "color": "#fde047" },
        "property.comment.error": { "color": "#ef4444" },
        "string.comment.info": { "color": "#22c55e" },
      },
    },
  },
  "languages": {
    "Nix": {
      "language_servers": ["nixd", "nil", "..."],
      "formatter": { "external": { "command": "nixfmt", "arguments": [] } },
    },
    "Nu": {
      "formatter": {
        "external": { "command": "nufmt", "arguments": ["--stdin"] },
      },
    },
    "CSS": {
      "prettier": { "allowed": false },
      "formatter": {
        "external": {
          "command": "prettier",
          "arguments": ["--stdin-filepath", "{buffer_path}"],
        },
      },
    },
    "HTML": {
      "prettier": { "allowed": false },
      "formatter": {
        "external": {
          "command": "prettier",
          "arguments": ["--stdin-filepath", "{buffer_path}"],
        },
      },
    },
    "TypeScript": {
      "language_servers": ["typescript-language-server", "!vtsls", "..."],
      "prettier": { "allowed": false },
      "formatter": {
        "external": {
          "command": "prettier",
          "arguments": ["--stdin-filepath", "{buffer_path}"],
        },
      },
    },
    "TSX": {
      "language_servers": ["typescript-language-server", "!vtsls", "..."],
      "prettier": { "allowed": false },
      "formatter": {
        "external": {
          "command": "prettier",
          "arguments": ["--stdin-filepath", "{buffer_path}"],
        },
      },
    },
    "JavaScript": {
      "language_servers": ["typescript-language-server", "!vtsls", "..."],
      "prettier": { "allowed": false },
      "formatter": {
        "external": {
          "command": "prettier",
          "arguments": ["--stdin-filepath", "{buffer_path}"],
        },
      },
    },
    "Markdown": {
      "format_on_save": "on",
      "language_servers": ["marksman", "..."],
      "prettier": { "allowed": false },
      "formatter": {
        "external": {
          "command": "prettier",
          "arguments": ["--stdin-filepath", "{buffer_path}"],
        },
      },
    },
  },
}
