+
+// the pak files are opened by bare name, so without this they land in the cwd, which is read-only for an installed build
+static std::filesystem::path pak_path(const char* name) {
+    std::filesystem::path folder = config_path / u8"saves";
+    std::error_code ec;
+    std::filesystem::create_directories(folder, ec);
+    return folder / name;
