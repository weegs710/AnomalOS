// declared baseline for zed; gui edits get pulled back into the repo with `zed-s` (copy-type, see nushell/config.nu)
{
  "cli_default_open_behavior": "existing_window",
  "preferred_line_length": 80,
  "horizontal_scroll_margin": 999.0,
  "vertical_scroll_margin": 999.0,
  "proxy": "",
  "show_whitespaces": "all",
  "disable_ai": true,
  "code_lens": "menu",
  "current_line_highlight": "line",
  "colorize_brackets": true,
  "lsp_insert_mode": "replace",
  "redact_private_values": true,
  "tab_size": 2,
  "diff_view_style": "unified",
  "image_viewer": {
    "unit": "decimal",
  },
  "diagnostics": {
    "inline": {
      "enabled": true,
      "max_severity": "error",
    },
  },
  "indent_guides": {
    "background_coloring": "indent_aware",
    "active_line_width": 3,
    "coloring": "indent_aware",
    "line_width": 1,
  },
  "toolbar": {
    "agent_review": false,
    "breadcrumbs": false,
    "quick_actions": false,
  },
  "minimap": {
    "thumb_border": "none",
    "thumb": "hover",
  },
  "which_key": {
    "delay_ms": 0,
    "enabled": true,
  },
  "icon_theme": "Light Charmed Icons",
  "buffer_font_size": 16.0,
  "ui_font_size": 18.0,
  "ui_font_family": "Terminess Nerd Font",
  "buffer_line_height": "standard",
  "buffer_font_family": "Terminess Nerd Font Mono",
  "telemetry": {
    "diagnostics": false,
    "metrics": false,
    "anthropic_retention": false,
  },
  "terminal": {
    "copy_on_select": false,
    "blinking": "on",
    "cursor_shape": "bar",
    "font_family": "Terminess Nerd Font Mono",
    "font_size": 14.0,
  },
  "collaboration_panel": {
    "button": false,
  },
  "outline_panel": {
    "button": false,
  },
  "git_panel": {
    "button": false,
  },
  "tab_bar": {
    "show_nav_history_buttons": false,
    "show_tab_bar_buttons": false,
  },
  "tabs": {
    "activate_on_close": "neighbour",
    "file_icons": true,
    "git_status": false,
    "show_diagnostics": "errors",
  },
  "project_panel": {
    "dock": "left",
    "git_status": false,
    "hide_root": true,
    "scrollbar": {
      "show": "never",
    },
  },
  "theme": "Noctalia Dark Transparent",
  "format_on_save": "on",

  // grammar + adapter wasm for non-core languages (html auto-installs by zed default)
  "auto_install_extensions": {
    "nix": true,
    "nu": true,
    "marksman": true,
    "charmed-icons": true,
  },
  "title_bar": {
    "show_branch_status_icon": true,
    "show_onboarding_banner": false,
    "show_sign_in": false,
    "show_user_menu": false,
    "show_user_picture": false,
  },
  "theme_overrides": {
    "Noctalia Dark Transparent": {
      "syntax": {
        "constant.comment.todo": { "color": "#fb923c" },
        "keyword.comment.warn": { "color": "#fde047" },
        "property.comment.error": { "color": "#ef4444" },
        "string.comment.info": { "color": "#22c55e" },
      },
    },
  },
  "languages": {
    "Nix": {
      "language_servers": ["nixd", "nil", "..."],
      "formatter": { "external": { "command": "nixfmt", "arguments": [] } },
    },
    "Nu": {
      "formatter": {
        "external": { "command": "nufmt", "arguments": ["--stdin"] },
      },
    },
    "CSS": {
      "prettier": { "allowed": false },
      "formatter": {
        "external": {
          "command": "prettier",
          "arguments": ["--stdin-filepath", "{buffer_path}"],
        },
      },
    },
    "HTML": {
      "prettier": { "allowed": false },
      "formatter": {
        "external": {
          "command": "prettier",
          "arguments": ["--stdin-filepath", "{buffer_path}"],
        },
      },
    },
    "TypeScript": {
      "language_servers": ["typescript-language-server", "!vtsls", "..."],
      "prettier": { "allowed": false },
      "formatter": {
        "external": {
          "command": "prettier",
          "arguments": ["--stdin-filepath", "{buffer_path}"],
        },
      },
    },
    "TSX": {
      "language_servers": ["typescript-language-server", "!vtsls", "..."],
      "prettier": { "allowed": false },
      "formatter": {
        "external": {
          "command": "prettier",
          "arguments": ["--stdin-filepath", "{buffer_path}"],
        },
      },
    },
    "JavaScript": {
      "language_servers": ["typescript-language-server", "!vtsls", "..."],
      "prettier": { "allowed": false },
      "formatter": {
        "external": {
          "command": "prettier",
          "arguments": ["--stdin-filepath", "{buffer_path}"],
        },
      },
    },
    "Markdown": {
      "format_on_save": "on",
      "language_servers": ["marksman", "..."],
      "prettier": { "allowed": false },
      "formatter": {
        "external": {
          "command": "prettier",
          "arguments": ["--stdin-filepath", "{buffer_path}"],
        },
      },
    },
  },

  // hl is injected by hyprland's lua runtime, so lua_ls flags it undefined-global without this
  "lsp": {
    "lua-language-server": {
      "settings": {
        "Lua": {
          "diagnostics": {
            "globals": ["hl"],
          },
        },
      },
    },
  },
}
