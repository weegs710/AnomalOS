+// Returns selected locations sorted by selection order
+func (m *Model) GetSelectedLocationsOrdered() []string {
+	type entry struct {
+		loc   string
+		order int
+	}
+	entries := make([]entry, 0, len(m.selected))
+	for loc, order := range m.selected {
+		entries = append(entries, entry{loc, order})
+	}
+	sort.Slice(entries, func(i, j int) bool {
+		return entries[i].order < entries[j].order
+	})
+	result := make([]string, 0, len(entries))
+	for _, e := range entries {
+		result = append(result, e.loc)
+	}
+	return result
+}
