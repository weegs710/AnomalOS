+#[cfg(target_os = "linux")]
+fn clipboard_image_attachment() -> Option<MessageAttachmentUpload> {
+    use std::{
+        process::Command,
+        time::{SystemTime, UNIX_EPOCH},
+    };
+
+    let types = Command::new("wl-paste").arg("--list-types").output().ok()?;
+    if !types.status.success() {
+        return None;
+    }
+    let types_str = String::from_utf8_lossy(&types.stdout);
+    let mime_type = types_str
+        .lines()
+        .find(|t| {
+            matches!(
+                *t,
+                "image/png" | "image/jpeg" | "image/jpg" | "image/gif" | "image/webp"
+            )
+        })?
+        .to_owned();
+
+    let ext = match mime_type.as_str() {
+        "image/jpeg" | "image/jpg" => "jpg",
+        "image/gif" => "gif",
+        "image/webp" => "webp",
+        _ => "png",
+    };
+    let ts = SystemTime::now()
+        .duration_since(UNIX_EPOCH)
+        .ok()?
+        .as_millis();
+    let path = PathBuf::from(format!("/tmp/concord-clip-{ts}.{ext}"));
+
+    let data = Command::new("wl-paste")
+        .arg("--type")
+        .arg(&mime_type)
+        .output()
+        .ok()?;
+    if !data.status.success() || data.stdout.is_empty() {
+        return None;
+    }
+
+    std::fs::write(&path, &data.stdout).ok()?;
+    let size_bytes = path.metadata().ok()?.len();
+    let filename = format!("clipboard-{ts}.{ext}");
+
+    Some(MessageAttachmentUpload { filename, path, size_bytes })
+}
