+pub(super) fn build_emoji_candidates(
+    query: &str,
+    custom_emojis: &[CustomEmojiInfo],
+) -> Vec<EmojiPickerEntry> {
+    let needle = query.to_lowercase();
+    let mut results: Vec<(u8, EmojiPickerEntry)> = Vec::new();
+
+    for emoji in custom_emojis {
+        let name_lower = emoji.name.to_lowercase();
+        let rank = if name_lower.starts_with(&needle) { 0 } else if name_lower.contains(&needle) { 1 } else { continue };
+        let text = if emoji.animated {
+            format!("<a:{}:{}>", emoji.name, emoji.id.get())
+        } else {
+            format!("<:{}:{}>", emoji.name, emoji.id.get())
+        };
+        results.push((rank, EmojiPickerEntry { name: format!(":{}:", emoji.name), text }));
+    }
+
+    for (name, ch) in UNICODE_EMOJI_LIST {
+        let rank = if name.starts_with(&needle) { 2 } else if name.contains(&needle) { 3 } else { continue };
+        results.push((rank, EmojiPickerEntry { name: format!(":{}:", name), text: ch.to_string() }));
+    }
+
+    results.sort_by_key(|(rank, entry)| (*rank, entry.name.clone()));
+    results.truncate(MAX_EMOJI_PICKER_VISIBLE);
+    results.into_iter().map(|(_, e)| e).collect()
+}
