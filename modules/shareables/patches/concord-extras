+    #[cfg(all(unix, not(target_os = "macos")))]
+    {
+        let mut child = Command::new("wl-copy")
+            .stdin(Stdio::piped())
+            .spawn()?;
+        if let Some(mut stdin) = child.stdin.take() {
+            stdin.write_all(text.as_bytes())?;
+        }
