+fn fit_image_to_canvas_centered(image: &DynamicImage, width: u32, height: u32) -> DynamicImage {
+    let resized = image.resize(width, height, FilterType::Nearest);
+    if resized.width() == width && resized.height() == height {
+        return resized;
+    }
+    let x = (width.saturating_sub(resized.width()) / 2) as i64;
+    let y = (height.saturating_sub(resized.height()) / 2) as i64;
+    let mut canvas =
+        DynamicImage::ImageRgba8(ImageBuffer::from_pixel(width, height, Rgba([0, 0, 0, 0])));
+    image::imageops::overlay(&mut canvas, &resized, x, y);
+    canvas
+}
