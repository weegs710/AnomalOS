+pub(crate) fn extract_message_urls(message: &MessageState) -> Vec<String> {
+    let mut urls: Vec<String> = Vec::new();
+    if let Some(content) = message.content.as_deref() {
+        for (start, end) in find_url_ranges(content) {
+            urls.push(content[start..end].to_owned());
+        }
+    }
+    for embed in &message.embeds {
+        // skip embed page URLs when the embed has an inline image preview
+        // (those are accessible via "View image" -- "Open link" would open a web page instead)
+        if embed.inline_preview_info().is_some() {
+            continue;
+        }
+        if let Some(url) = embed.url.as_deref() {
+            if !urls.iter().any(|u| u == url) {
+                urls.push(url.to_owned());
+            }
+        }
+    }
+    urls
