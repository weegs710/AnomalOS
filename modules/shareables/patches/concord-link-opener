+pub(crate) fn extract_message_urls(message: &MessageState) -> Vec<String> {
+    let mut urls: Vec<String> = Vec::new();
+    if let Some(content) = message.content.as_deref() {
+        for (start, end) in find_url_ranges(content) {
+            urls.push(content[start..end].to_owned());
+        }
+    }
+    for embed in &message.embeds {
+        if let Some(url) = embed.url.as_deref() {
+            if !urls.iter().any(|u| u == url) {
+                urls.push(url.to_owned());
+            }
+        }
+    }
+    urls
+}
+
+fn find_url_ranges(text: &str) -> Vec<(usize, usize)> {
+    let mut ranges = Vec::new();
+    let bytes = text.as_bytes();
+    let len = bytes.len();
+    let mut i = 0;
+    while i < len {
+        let prefix_len = if i + 8 <= len && &bytes[i..i + 8] == b"https://" {
+            8
+        } else if i + 7 <= len && &bytes[i..i + 7] == b"http://" {
+            7
+        } else {
+            i += 1;
+            continue;
+        };
+        let start = i;
+        i += prefix_len;
+        while i < len && is_url_char(bytes[i]) {
+            i += 1;
+        }
+        let mut end = i;
+        while end > start + prefix_len
+            && matches!(bytes[end - 1], b'.' | b',' | b';' | b':' | b'!' | b'?' | b')' | b']')
+        {
+            end -= 1;
+        }
+        if end > start + prefix_len {
+            ranges.push((start, end));
+        }
+    }
+    ranges
+}
+
+fn is_url_char(b: u8) -> bool {
+    b > b' ' && !matches!(b, b'<' | b'>' | b'"' | b'`' | b'[' | b']' | b'{' | b'}')
+}
