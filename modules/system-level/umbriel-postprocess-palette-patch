+    vec4 to = umbriel_palette[0];
+    for (int i = 0; i < 8; i++) {
+        if (i >= umbriel_palette_count) break;
+        if (float(i) == index) from = umbriel_palette[i];
+        if (float(i) == next) to = umbriel_palette[i];
+    }
+    return mix(from, to, scaled - index);
