new file mode 100644
index 0000000..b263fcc
--- /dev/null
+++ b/src/output/dpms_hold.cpp
@@ -0,0 +1,43 @@
+#include "output/dpms_hold.h"
+
+#include <algorithm>
+
+namespace umbriel {
+
+  namespace {
+
+    std::string descriptorFor(const OutputIdentity& identity) {
+      if (identity.make.empty() && identity.model.empty() && identity.serial.empty()) {
+        return {};
+      }
+      return outputDescriptor(identity);
+    }
+
+  } // namespace
+
+  void OutputDpmsHold::remember(const OutputIdentity& identity, Clock::time_point now) {
+    const std::string descriptor = descriptorFor(identity);
+    const auto same = std::ranges::find_if(m_entries, [&](const Entry& entry) {
+      return outputNamesEqual(entry.connector, identity.connector) && outputNamesEqual(entry.descriptor, descriptor);
+    });
+    if (same != m_entries.end()) {
+      same->since = now;
+      return;
+    }
+    m_entries.push_back({.connector = std::string(identity.connector), .descriptor = descriptor, .since = now});
+  }
+
+  bool OutputDpmsHold::take(const OutputIdentity& identity, Clock::time_point now) {
+    std::erase_if(m_entries, [now](const Entry& entry) { return now - entry.since > kWindow; });
+    const std::string descriptor = descriptorFor(identity);
+    const auto match = std::ranges::find_if(m_entries, [&](const Entry& entry) {
+      return outputNamesEqual(entry.connector, identity.connector) && outputNamesEqual(entry.descriptor, descriptor);
+    });
+    if (match == m_entries.end()) {
+      return false;
+    }
+    m_entries.erase(match);
+    return true;
+  }
+
+} // namespace umbriel
diff --git a/src/output/dpms_hold.h b/src/output/dpms_hold.h
new file mode 100644
