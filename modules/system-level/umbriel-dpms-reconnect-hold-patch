diff --git a/tests/harness/checks/output/dpms_reconnect.sh b/tests/harness/checks/output/dpms_reconnect.sh
new file mode 100755
index 0000000..2bcb12b
--- /dev/null
+++ b/tests/harness/checks/output/dpms_reconnect.sh
@@ -0,0 +1,49 @@
+#!/usr/bin/env bash
+# harness: outputs=2
+# Some sinks drop and re-assert hotplug detect while they sleep, so a DPMS-off output is destroyed and rebuilt a moment
+# later. The rebuilt output must stay powered off, and only the output that was off may be held.
+set -euo pipefail
+
+log_mark() { wc -l < "$UMBRIEL_LOG"; }
+
+wait_for_log_since() {
+  local mark=$1 pattern=$2
+  for _ in $(seq 40); do
+    if tail -n +"$((mark + 1))" "$UMBRIEL_LOG" | grep -q "$pattern"; then
+      return 0
+    fi
+    sleep 0.1
+  done
+  echo "timed out waiting for log: $pattern"
+  tail -12 "$UMBRIEL_LOG" | sed 's/^/  | /'
+  return 1
+}
+
+power_of() { "$UMBRIEL" outputs | awk -v name="$1" '$1 == name { found = 1 } found && /Power:/ { print $2; exit }'; }
+
+"$UMBRIEL" msg dpms-off:headless-2 > /dev/null
+[[ $(power_of HEADLESS-2) == off ]] || { echo "HEADLESS-2 did not power off"; exit 1; }
+
+mark=$(log_mark)
+"$UMBRIEL" output-destroy HEADLESS-2 > /dev/null
+"$UMBRIEL" output-create HEADLESS-2 > /dev/null
+wait_for_log_since "$mark" "output 'HEADLESS-2': staying powered off across reconnect"
+[[ $(power_of HEADLESS-2) == off ]] || { echo "rebuilt HEADLESS-2 powered on"; exit 1; }
+[[ $(power_of HEADLESS-1) == on ]] || { echo "HEADLESS-1 lost power"; exit 1; }
+
+# The hold is consumed by the first return, so a second rebuild of a woken output stays awake.
+"$UMBRIEL" msg dpms-on:headless-2 > /dev/null
+mark=$(log_mark)
+"$UMBRIEL" output-destroy HEADLESS-2 > /dev/null
+"$UMBRIEL" output-create HEADLESS-2 > /dev/null
+for _ in $(seq 40); do
+  [[ $(power_of HEADLESS-2) == on ]] && break
+  sleep 0.1
+done
+[[ $(power_of HEADLESS-2) == on ]] || { echo "woken HEADLESS-2 came back off"; exit 1; }
+if tail -n +"$((mark + 1))" "$UMBRIEL_LOG" | grep -q "staying powered off"; then
+  echo "a woken output was held off"
+  exit 1
+fi
+
+echo "a DPMS-off output stays off across a quick reconnect and a woken one does not"
