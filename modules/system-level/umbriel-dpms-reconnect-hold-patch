diff --git a/tests/unit/output_dpms_hold.cpp b/tests/unit/output_dpms_hold.cpp
new file mode 100644
index 0000000..0aa054c
--- /dev/null
+++ b/tests/unit/output_dpms_hold.cpp
@@ -0,0 +1,54 @@
+#include "check.h"
+#include "output/dpms_hold.h"
+
+using umbriel::OutputDpmsHold;
+using umbriel::OutputIdentity;
+using Clock = OutputDpmsHold::Clock;
+
+namespace {
+
+  OutputIdentity identified(std::string_view connector, std::string_view serial) {
+    return {
+        .connector = connector,
+        .make = "Example",
+        .model = "Panel",
+        .serial = serial,
+    };
+  }
+
+  const Clock::time_point kStart{};
+
+} // namespace
+
+UMBRIEL_TEST(sameOutputReturningInsideTheWindowStaysOff) {
+  OutputDpmsHold hold;
+  hold.remember(identified("HDMI-A-1", "A"), kStart);
+  CHECK(hold.take(identified("HDMI-A-1", "A"), kStart + std::chrono::seconds(1)));
+}
+
+UMBRIEL_TEST(holdIsConsumedByTheFirstReturn) {
+  OutputDpmsHold hold;
+  hold.remember(identified("HDMI-A-1", "A"), kStart);
+  CHECK(hold.take(identified("HDMI-A-1", "A"), kStart + std::chrono::seconds(1)));
+  CHECK(!hold.take(identified("HDMI-A-1", "A"), kStart + std::chrono::seconds(2)));
+}
+
+UMBRIEL_TEST(outputReturningAfterTheWindowWakes) {
+  OutputDpmsHold hold;
+  hold.remember(identified("HDMI-A-1", "A"), kStart);
+  CHECK(!hold.take(identified("HDMI-A-1", "A"), kStart + OutputDpmsHold::kWindow + std::chrono::seconds(1)));
+}
+
+UMBRIEL_TEST(differentMonitorOnTheSameConnectorWakes) {
+  OutputDpmsHold hold;
+  hold.remember(identified("HDMI-A-1", "A"), kStart);
+  CHECK(!hold.take(identified("HDMI-A-1", "B"), kStart + std::chrono::seconds(1)));
+}
+
+UMBRIEL_TEST(sameMonitorOnAnotherConnectorWakes) {
+  OutputDpmsHold hold;
+  hold.remember(identified("HDMI-A-1", "A"), kStart);
+  CHECK(!hold.take(identified("HDMI-A-2", "A"), kStart + std::chrono::seconds(1)));
+}
+
+int main() { return RUN_TESTS(); }
