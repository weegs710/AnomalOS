+++ b/src/output/dpms_hold.h
@@ -0,0 +1,34 @@
+#pragma once
+
+#include "output/identity.h"
+
+#include <chrono>
+#include <string>
+#include <vector>
+
+namespace umbriel {
+
+  // A DPMS-off output whose connector vanished and came back right away. Some sinks drop and re-assert hotplug detect
+  // while they sleep, which destroys the Output and builds a fresh one that would otherwise power on.
+  class OutputDpmsHold {
+  public:
+    using Clock = std::chrono::steady_clock;
+
+    // Longer than the sink's drop-and-return, short enough that a real replug still wakes the display.
+    static constexpr std::chrono::seconds kWindow{5};
+
+    void remember(const OutputIdentity& identity, Clock::time_point now);
+    // True once per remembered output that returns inside the window.
+    [[nodiscard]] bool take(const OutputIdentity& identity, Clock::time_point now);
+
+  private:
+    struct Entry {
+      std::string connector;
+      std::string descriptor;
+      Clock::time_point since;
+    };
+
+    std::vector<Entry> m_entries;
+  };
+
+} // namespace umbriel
